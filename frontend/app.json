{
  "expo": {
    "name": "Pizca",
    "slug": "fogon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pizca",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pedroyorlano.fogon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pedroyorlano.fogon",
      "adaptiveIcon": {
        "backgroundColor": "#BE9F00",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "text/plain"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9EC",
          "dark": {
            "backgroundColor": "#3F3128"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-share-extension",
        {
          "activationRules": [
            {
              "NSExtensionActivationSupportsWebURLWithMaxCount": 1
            }
          ],
          "backgroundColor": {
            "red": 255,
            "green": 249,
            "blue": 236,
            "alpha": 1
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Pizca usa el micrófono para que puedas dictar tus recetas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "FOGONShareExtension",
                  "bundleIdentifier": "com.pedroyorlano.fogon.ShareExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.pedroyorlano.fogon"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "61a0e1df-09ce-49c4-9575-0a96fb5c23ca"
      },
      "appleApplicationGroup": "group.com.pedroyorlano.fogon"
    }
  }
}
