# Copiar a .env.local (o configurarlas en EAS / el host de la web). Se fijan al compilar.

# Backend. Sin esto, en desarrollo se usa la IP de la compu con el puerto 8000.
# EXPO_PUBLIC_API_URL=https://api.pizca.app

# Web pública, para los links de recetas compartidas desde la app nativa.
# EXPO_PUBLIC_WEB_URL=https://pizca.app

