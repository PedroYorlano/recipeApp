# =========================================
# Fogón Backend — Variables de Entorno
# =========================================
# Copia este archivo como .env y completa los valores.
# NUNCA commitees el archivo .env real.

# --- Django ---
SECRET_KEY=tu-clave-secreta-aqui-genera-una-con-django
DEBUG=True

# --- Google Gemini (IA para estructurar recetas) ---
# Obtener en: https://aistudio.google.com/app/apikey
GENAI_API_KEY=tu-api-key-de-google-gemini

# --- Groq (Whisper para transcripción de audio) ---
# Obtener en: https://console.groq.com/keys
GROQ_API_KEY=tu-api-key-de-groq
