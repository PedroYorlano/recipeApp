# =========================================
# Pizca Backend — Variables de Entorno
# =========================================
# Copia este archivo como .env y completa los valores.
# NUNCA commitees el archivo .env real al repositorio.

# === Django ===
# Generá una clave única con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# En producción: DEBUG=False
DEBUG=True

# En producción: tu dominio real (ej: api.pizca.app)
ALLOWED_HOSTS=localhost,127.0.0.1

# En producción: solo tus dominios frontend (ej: https://pizca.app)
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Proxies de confianza delante del backend (para tomar la IP real en los límites por IP).
# Local: 0. En producción detrás de un proxy o balanceador: 1 (2 si además hay un CDN adelante).
NUM_PROXIES=0

# === Base de datos ===
# SQLite por defecto (local). En producción usar PostgreSQL.
# Docker override en docker-compose.yml apunta automáticamente al servicio 'db'.
DATABASE_URL=sqlite:///db.sqlite3

# === IA (Google Gemini) ===
# Obtené tu clave en: https://aistudio.google.com/app/apikey
GENAI_API_KEY=
# Opcional: modelo de Gemini (por defecto gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# === Storage (Cloudflare R2) — Opcional ===
# Si no se configura, las imágenes se guardan en disco local (/media/).
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=

# === Email (OTP de registro y recuperación) ===
# En dev, el backend de consola imprime los mails en la terminal.
# En producción: django.core.mail.backends.smtp.EmailBackend + datos del proveedor SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Pizca <hola@pizca.app>

# === OAuth del conector de Claude (MCP remoto) ===
# URL pública del MCP (su "resource"). Sus tokens también valen en /api/. Vacío = sin MCP remoto.
PIZCA_MCP_RESOURCE=
# Emisor OAuth fijo, p. ej. la URL de Cloud Run. Vacío = se deriva del request.
OAUTH_ISSUER=
# Orígenes https de los formularios de login y autorización (la URL de este backend).
CSRF_TRUSTED_ORIGINS=
# Credenciales con las que el MCP llama a /o/introspect/. Las mismas van en el servicio del MCP.
# Generar el secreto con: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_INTROSPECTION_CLIENT_ID=
MCP_INTROSPECTION_CLIENT_SECRET=
# Hosts desde donde se aceptan clientes CIMD (client_id = URL). Por defecto, solo Claude.
OAUTH_CIMD_ALLOWED_HOSTS=claude.ai
